{
    "name": "@hodfords/nestjs-validation",
    "version": "12.3.0",
    "packageManager": "pnpm@12.0.0",
    "description": "A utility for simplifying validation and providing translated error messages in NestJS applications",
    "type": "module",
    "main": "./index.js",
    "types": "./index.d.ts",
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.js",
            "default": "./index.js"
        },
        "./package.json": "./package.json"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "prebuild": "rimraf dist *.tsbuildinfo",
        "build": "tsc",
        "postbuild": "cp package.json dist/lib && cp README.md dist/lib && cp .npmrc dist/lib",
        "prepare": "is-ci || husky",
        "format": "prettier --write \"lib/**/*.ts\" \"sample/**/*.ts\"",
        "cspell": "cspell",
        "lint": "eslint \"lib/**/*.ts\" \"sample/**/*.ts\" --fix --max-warnings 0",
        "lint-staged": "lint-staged",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:cov": "vitest run --coverage",
        "start": "nest start",
        "start:dev": "pnpm run prebuild && nest start --watch"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hodfords-solutions/nestjs-validation"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/hodfords-solutions/nestjs-validation/issues"
    },
    "homepage": "https://opensource.hodfords.uk/",
    "devDependencies": {
        "@commitlint/cli": "21.2.2",
        "@commitlint/config-conventional": "21.2.2",
        "@grpc/grpc-js": "1.14.4",
        "@hodfords/nestjs-cls-translation": "12.1.0",
        "@hodfords/nestjs-eslint-config": "11.0.4",
        "@hodfords/nestjs-exception": "12.1.0",
        "@hodfords/nestjs-prettier-config": "11.0.2",
        "@nestjs/cli": "12.0.0",
        "@nestjs/common": "12.0.1",
        "@nestjs/core": "12.0.1",
        "@nestjs/platform-express": "12.0.1",
        "@nestjs/testing": "12.0.1",
        "@swc/core": "^1.16.1",
        "@types/node": "26.4.0",
        "class-transformer": "0.5.1",
        "class-validator": "npm:@hodfords/turbo-validator@1.0.0",
        "cspell": "10.1.1",
        "eslint": "10.9.1",
        "husky": "9.1.7",
        "is-ci": "4.1.0",
        "lint-staged": "17.4.1",
        "lodash": "4.18.1",
        "nestjs-i18n": "10.8.5",
        "reflect-metadata": "0.2.2",
        "rimraf": "6.1.3",
        "typeorm": "1.1.0",
        "typescript": "6.0.3",
        "unplugin-swc": "^1.5.11",
        "vitest": "^4.1.11"
    },
    "peerDependencies": {
        "@nestjs/common": ">=12.0.0",
        "class-validator": "*",
        "rxjs": ">=7.0.0"
    },
    "peerDependenciesMeta": {
        "rxjs": {
            "optional": true
        }
    }
}
