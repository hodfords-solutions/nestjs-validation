{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "lib": [
            "es2023"
        ],
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": "./",
        "baseUrl": "./",
        "incremental": true
    },
    "include": [
        "lib",
        "sample"
    ],
    "exclude": [
        "tests",
        "test",
        "dist",
        "node_modules"
    ]
}
